# Firebase web app settings (these identify the public app; never put Admin credentials here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty to use the Vite /api proxy to the local backend
VITE_API_BASE_URL=
